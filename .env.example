# Variables read by docreader. Copy to a machine-local file and fill in:
#
#     cp .env.example .env          # working set (Mac) or manual demo runs (dev server)
#     cp .env.example .env.bench    # engine benchmark on the Mac (quickstart B1, feature 13)
#
# Local files (.env, .env.*) are git-ignored; only this example is committed.
# Never put real contract data, gold data or run results here.
#
# They are loaded per command, never globally, so pytest does not see them:
#
#     uv run --env-file .env docreader ...
#
# Shortcuts for ~/.zprofile on the Mac (run from the repository folder):
#
#     alias dr='uv run --env-file .env docreader'
#     alias drb='uv run --env-file .env.bench docreader'
#
# Commands that read the settings but are not docreader itself (feature 13, Mac only):
#
#     uv run --env-file .env pytest -m real_model tests/real_model/
#     uv run --env-file .env python -m tests.synthetic.record_recognition

# Data folder: copies of the documents, reports, settings.toml. Must be outside the
# repository (docreader refuses otherwise). `~` is expanded.
#   Mac, working set:   ~/docreader-data
#   Mac, benchmark:     ~/docreader-ocrbench
#   dev server, demo:   /tmp/docreader-demo-data   (synthetic files only, see tasks T050)
DOCREADER_DATA_DIR=~/docreader-data

# Local PostgreSQL only. Default: postgresql:///docreader
#   Mac, working set:   postgresql:///docreader
#   Mac, benchmark:     postgresql:///docreader_ocrbench
#   dev server, demo:   postgresql:///docreader_demo
DOCREADER_DATABASE_URL=postgresql:///docreader

# Blocks the recognition engine (feature 13) and the language model (feature 05). ANY
# non-empty value blocks them, so "0" or "false" block them too: on the Mac leave this
# line out entirely.
# The dev server sets it to 1 (compose.yaml, test fixtures); set it there for demo runs.
# DOCREADER_FORBID_MODELS=1

# Tests only: admin URL of a local PostgreSQL role with CREATEDB; each run creates and
# drops a throwaway docreader_test_* database. Pass it on the command line instead:
#     DOCREADER_TEST_DATABASE_URL=postgresql:///postgres uv run pytest
# DOCREADER_TEST_DATABASE_URL=postgresql:///postgres

# Recording model answers on synthetic contracts (feature 05, Mac only): the model server
# address for `python -m tests.synthetic.record_extraction`; this machine only.
# DOCREADER_RECORD_BASE_URL=http://127.0.0.1:8080/v1
